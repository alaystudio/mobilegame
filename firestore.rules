rules_version = '2';
// Orbitap sıralama tablosu: herkes okuyabilir, yazılan kayıt sıkı biçimde doğrulanır.
service cloud.firestore {
  match /databases/{database}/documents {
    // Anonim tur istatistikleri: sadece oluşturulabilir, alanlar ve aralıklar sabit.
    // Okuma açık (kişisel veri yok); rapor için `npm run stats`.
    match /runs/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['v', 'plat', 'lang', 'score', 'passed', 't', 'rings', 'start', 'dring', 'pt', 'perf', 'rev', 'ctrl', 'ch', 'mod', 'ts'])
        && request.resource.data.v is string && request.resource.data.v.size() <= 16
        && request.resource.data.plat is string && request.resource.data.plat.size() <= 16
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 16
        && request.resource.data.ctrl in ['tap', 'zones']
        && request.resource.data.mod is string && request.resource.data.mod.size() <= 16
        && request.resource.data.ch is bool
        && request.resource.data.score is int && request.resource.data.score < 100000
        && request.resource.data.passed is int && request.resource.data.passed < 100000
        && request.resource.data.t is int && request.resource.data.t < 86400
        && request.resource.data.pt is int && request.resource.data.pt < 86400
        && request.resource.data.rings is int && request.resource.data.rings <= 4
        && request.resource.data.start is int && request.resource.data.start <= 4
        && request.resource.data.dring is int && request.resource.data.dring <= 4
        && request.resource.data.perf is int && request.resource.data.perf < 100000
        && request.resource.data.rev is int && request.resource.data.rev <= 5
        && request.resource.data.ts is timestamp;
    }

    match /{col}/{pid} {
      allow read: if col == 'scores_all' || col.matches('scores_daily-[0-9]{4}-[0-9]{2}-[0-9]{2}');
      allow write: if (col == 'scores_all' || col.matches('scores_daily-[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && pid.matches('p[a-z0-9]{1,16}')
        && request.resource.data.keys().hasOnly(['name', 'score', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 14
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score < 100000;
    }
  }
}