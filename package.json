{
  "name": "yorunge",
  "version": "1.0.0",
  "private": true,
  "description": "Yörünge: tek dokunuşla oynanan mobil arcade oyunu",
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "sync": "npm run build && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios",
    "assets": "node scripts/make-store-assets.mjs && npx capacitor-assets generate --android --ios --iconBackgroundColor \"#05060f\" --iconBackgroundColorDark \"#05060f\" --splashBackgroundColor \"#05060f\" --splashBackgroundColorDark \"#05060f\"",
    "screenshots": "node scripts/screenshots.mjs",
    "serve": "npx --yes serve -l 8123 ."
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "playwright": "^1.63.0"
  }
}
